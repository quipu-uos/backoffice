{
  "openapi": "3.0.0",
  "info": {
    "title": "forum API",
    "version": "0.0.1",
    "description": "quipu backoffice API용 Swagger"
  },
  "paths": {
    "/bo/auth/login": {
      "post": {
        "summary": "로그인",
        "description": "BO에 로그인",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "사용자가 값을 입력하지 않아도, 항상 admin이라는 값으로 오도록 설정해주세요",
                    "example": "admin"
                  },
                  "password": {
                    "type": "string",
                    "description": "비밀번호",
                    "example": "quipuadmin0316@!"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 완료",
            "content": {
              "application/json": {
                "example": {
                  "message": "로그인 성공"
                }
              }
            }
          },
          "401": {
            "description": "비밀번호 틀림",
            "content": {
              "application/json": {
                "example": {
                  "message": "비밀번호가 틀림"
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "example": {
                  "message": "서버 에러"
                }
              }
            }
          }
        }
      }
    },
    "/bo/member": {
      "get": {
        "summary": "동아리 신청 인원 조회",
        "description": "member 테이블 조회",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "message": "조회 성공"
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "example": {
                  "message": "서버 에러"
                }
              }
            }
          }
        }
      }
    },
    "/bo/member/pdf/{filename}": {
      "get": {
        "summary": "동아리 신청 시 제출한 pdf 파일 조회",
        "description": "Cloudflare R2 quipu-recruit-portfolio bucket 조회, Presigned URL을 생성해서 FE에게 반환",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "description": "다운로드할 PDF 파일의 이름",
            "schema": {
              "type": "string",
              "example": "퀴푸_25_1-2020440102이제민.pdf"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "example": "https://r2-cloudflare-example.com/presigned-url"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청"
          },
          "500": {
            "description": "서버 에러"
          }
        }
      }
    },
    
  "/bo/semina": {
    "post": {
      "summary": "세미나 정보 등록 및 파일 업로드",
      "description": "세미나 정보를 DB에 저장, 관련 파일을 Cloudflare R2에 업로드",
      "consumes": ["multipart/form-data"],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "example": "swagger테스터"
                },
                "topic": {
                  "type": "string",
                  "example": "swagger테스트"
                },
                "detail": {
                  "type": "string",
                  "example": "swagger로 테스트 중임"
                },
                "resources": {
                  "type": "string",
                  "example": "https://example.com/resources.pdf"
                },
                "presentation_date": {
                  "type": "string",
                  "format": "date",
                  "example": "2025-03-01"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "데이터 저장 및 파일 업로드 성공",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "데이터 저장 및 파일 업로드 성공"
                  },
                  "semina": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "speaker": {
                        "type": "string",
                        "example": "swagger테스터"
                      },
                      "topic": {
                        "type": "string",
                        "example": "swagger테스트"
                      },
                      "presentation_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-03-01"
                      }
                    }
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "original_filename.pdf"
                    }
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "잘못된 요청",
          "content": {
            "application/json": {
              "example": {
                "message": "업로드할 파일이 없습니다."
              }
            }
          }
        },
        "500": {
          "description": "서버 오류",
          "content": {
            "application/json": {
              "example": {
                "message": "서버 오류"
              }
            }
          }
        }
      }
    }
  },
    "/bo/auth/logout": {
      "get": {
        "summary": "로그아웃",
        "description": "로그아웃",
        "responses": {
          "200": {
            "description": "로그아웃",
            "content": {
              "application/json": {
                "example": {
                  "message": "로그아웃 완료"
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "example": {
                  "message": "로그아웃 중 오류 발생"
                }
              }
            }
          }
        }
      }
    },
    "/bo/feature/recruit": {
      "get": {
        "summary": "recruit 상태 조회",
        "description": "현재 recruit의 상태(is_enabled)를 조회합니다.",
        "responses": {
          "200": {
            "description": "recruit 상태 조회 성공",
            "content": {
              "application/json": {
                "example": {
                  "is_enabled": true
                }
              }
            }
          },
          "404": {
            "description": "해당 feature를 찾을 수 없음",
            "content": {
              "application/json": {
                "example": {
                  "message": "해당 feature를 찾을 수 없습니다."
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "example": {
                  "message": "서버 오류 발생"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "recruit 상태 변경",
        "description": "현재 recruit의 상태(is_enabled)를 변경(토글)합니다.",
        "responses": {
          "200": {
            "description": "recruit 상태 변경 성공",
            "content": {
              "application/json": {
                "example": {
                  "message": "recruit 상태가 변경되었습니다.",
                  "is_enabled": false
                }
              }
            }
          },
          "404": {
            "description": "해당 feature를 찾을 수 없음",
            "content": {
              "application/json": {
                "example": {
                  "message": "해당 feature를 찾을 수 없습니다."
                }
              }
            }
          },
          "500": {
            "description": "서버 에러",
            "content": {
              "application/json": {
                "example": {
                  "message": "서버 오류 발생"
                }
              }
            }
          }
        }
      }
    },
    "/bo/activity-types": {
      "post": {
        "tags": ["Activity CMS"],
        "summary": "Create ActivityType",
        "description": "Activity CMS에서 사용할 활동 타입과 필드 설계도를 생성합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateActivityTypeRequest"
              },
              "example": {
                "typeId": "study",
                "displayName": "스터디",
                "description": "정기 스터디 활동",
                "order": 1,
                "isActive": true,
                "fields": [
                  {
                    "fieldId": "topic",
                    "label": "주제",
                    "inputType": "shortText",
                    "required": true,
                    "order": 1
                  },
                  {
                    "fieldId": "details",
                    "label": "상세 설명",
                    "inputType": "longText",
                    "required": true,
                    "order": 2
                  },
                  {
                    "fieldId": "images",
                    "label": "이미지",
                    "inputType": "imageList",
                    "required": false,
                    "order": 3,
                    "fileConfig": {
                      "maxFiles": 5,
                      "maxSizeMB": 5
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityType"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "이미 존재하는 typeId"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "get": {
        "tags": ["Activity CMS"],
        "summary": "List ActivityTypes",
        "description": "활동 타입 설계도 목록을 조회합니다.",
        "parameters": [
          {
            "name": "isActive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "활성 타입만 조회하려면 true"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActivityType"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/bo/activity-types/order": {
      "patch": {
        "tags": ["Activity CMS"],
        "summary": "Reorder ActivityTypes",
        "description": "활동 타입 탭 노출 순서를 일괄 변경합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderActivityTypeRequest"
              },
              "example": {
                "items": [
                  {
                    "typeId": "study",
                    "order": 1
                  },
                  {
                    "typeId": "semina",
                    "order": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuccessMessage"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/bo/activity-types/{id}": {
      "patch": {
        "tags": ["Activity CMS"],
        "summary": "Update ActivityType",
        "description": "ActivityType을 수정합니다. id에는 MongoDB _id 또는 typeId를 넣을 수 있습니다.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "study"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityTypeRequest"
              },
              "example": {
                "displayName": "스터디",
                "description": "정기 스터디 및 프로젝트",
                "order": 1,
                "isActive": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityType"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/bo/activities": {
      "post": {
        "tags": ["Activity CMS"],
        "summary": "Create ActivityItem",
        "description": "ActivityType.fields 설계도에 맞는 실제 활동 데이터를 생성합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateActivityItemRequest"
              },
              "example": {
                "typeKey": "study",
                "order": 1,
                "isVisible": true,
                "data": {
                  "topic": "React 기초 스터디",
                  "details": "컴포넌트와 상태 관리를 학습합니다.",
                  "images": [
                    "https://example.com/study-1.png"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityItem"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "get": {
        "tags": ["Activity CMS"],
        "summary": "List ActivityItems",
        "description": "활동 콘텐츠 목록을 조회합니다.",
        "parameters": [
          {
            "name": "typeKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "study"
          },
          {
            "name": "isVisible",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "공개 콘텐츠만 조회하려면 true"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActivityItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/bo/activities/order": {
      "patch": {
        "tags": ["Activity CMS"],
        "summary": "Reorder ActivityItems",
        "description": "동일 typeKey 안에서 활동 콘텐츠 노출 순서를 일괄 변경합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderActivityItemRequest"
              },
              "example": {
                "typeKey": "study",
                "items": [
                  {
                    "_id": "662000000000000000000001",
                    "order": 1
                  },
                  {
                    "_id": "662000000000000000000002",
                    "order": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuccessMessage"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/bo/activities/{id}": {
      "patch": {
        "tags": ["Activity CMS"],
        "summary": "Update ActivityItem",
        "description": "ActivityItem을 수정합니다. id에는 MongoDB _id를 넣습니다.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "662000000000000000000001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActivityItemRequest"
              },
              "example": {
                "isVisible": true,
                "data": {
                  "topic": "React 심화 스터디",
                  "details": "Hooks와 렌더링 최적화를 학습합니다.",
                  "images": [
                    "https://example.com/study-2.png"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityItem"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": ["Activity CMS"],
        "summary": "Delete ActivityItem",
        "description": "ActivityItem을 삭제합니다.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "662000000000000000000001"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SuccessMessage"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityField": {
        "type": "object",
        "required": ["fieldId", "label", "inputType", "required", "order"],
        "properties": {
          "fieldId": {
            "type": "string",
            "example": "topic"
          },
          "label": {
            "type": "string",
            "example": "주제"
          },
          "inputType": {
            "type": "string",
            "enum": ["shortText", "longText", "date", "dateRange", "image", "imageList", "url", "icon"],
            "example": "shortText"
          },
          "required": {
            "type": "boolean",
            "example": true
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "fileConfig": {
            "type": "object",
            "properties": {
              "maxFiles": {
                "type": "integer",
                "minimum": 1,
                "example": 5
              },
              "maxSizeMB": {
                "type": "number",
                "minimum": 0,
                "example": 5
              }
            }
          }
        }
      },
      "ActivityType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "662000000000000000000001"
          },
          "typeId": {
            "type": "string",
            "example": "study"
          },
          "displayName": {
            "type": "string",
            "example": "스터디"
          },
          "description": {
            "type": "string",
            "example": "정기 스터디 활동"
          },
          "order": {
            "type": "integer",
            "example": 1
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityField"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
